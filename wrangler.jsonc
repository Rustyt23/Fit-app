{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-fit",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-fit",
      // Replace with the id printed by: npx wrangler d1 create family-fit
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Profile photos. Create once with: npx wrangler r2 bucket create family-fit-photos
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "family-fit-photos"
    }
  ],
  // Runs the scheduler every minute: reminders, closing weekly/monthly events.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    // The family's timezone: decides when "today" starts and when events end.
    "APP_TIMEZONE": "Asia/Kolkata",
    // Contact address shown to push services (use your own email).
    "VAPID_SUBJECT": "mailto:family-fit@example.com",
    "COOKIE_SECURE": "true"
  },
  "observability": { "enabled": true }
}
